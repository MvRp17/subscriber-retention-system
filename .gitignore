# Raw data (large, not ours to redistribute — see README for Kaggle download link)
# NOTE: "data" is a symlink to kkbox-churn-prediction-challenge/, and git's
# trailing-slash dir pattern does not match symlinks — so it's ignored by
# bare name too.
data
kkbox-churn-prediction-challenge/
*.csv

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Spark
spark-warehouse/
derby.log
metastore_db/

# MLflow local tracking store + registry db
mlruns/
mlflow.db
mlartifacts/

# Generated artifacts (feature tables, trained models, plots) — reproducible from scripts
artifacts/

# OS
.DS_Store

# Editors
.vscode/
.idea/
